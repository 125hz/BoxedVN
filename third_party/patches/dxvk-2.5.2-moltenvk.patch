+    Logger::warn(str::format(
+      "DxvkAdapter: compatibility feature mask active (geometry=",
+      enabledFeatures.core.features.geometryShader,
+      ", cull=", enabledFeatures.core.features.shaderCullDistance,
+      ", robust2=", enabledFeatures.extRobustness2.robustBufferAccess2,
+      ", null=", enabledFeatures.extRobustness2.nullDescriptor, ")"));

