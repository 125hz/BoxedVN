+  int length = std::snprintf(buffer, sizeof(buffer),
+    "BOXEDWINE_DXVK_ALLOCATION_FAILED tid=%lu kind=%s bytes=%lu alignment=%lu caller=%p image=%p\n",
+    static_cast<unsigned long>(GetCurrentThreadId()), kind,
+    static_cast<unsigned long>(size), static_cast<unsigned long>(alignment), caller, &__ImageBase);
+  if (length <= 0) return;
+  DWORD written = 0;
+  WriteFile(GetStdHandle(STD_ERROR_HANDLE), buffer,
