+// BoxedVN: observe failed allocations without replacing allocator semantics.
+#if defined(_WIN32) && defined(__i386__) && defined(__GNUC__)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <cstddef>
+#include <cstdio>
+#include <new>
+
+extern "C" IMAGE_DOS_HEADER __ImageBase;
+extern "C" void* __real__Znwj(std::size_t);
+extern "C" void* __real__Znaj(std::size_t);
+extern "C" void* __real__ZnwjSt11align_val_t(std::size_t, std::align_val_t);
+extern "C" void* __real__ZnajSt11align_val_t(std::size_t, std::align_val_t);
+extern "C" void __real__ZSt17__throw_bad_allocv();
+
+static void reportAllocationFailure(std::size_t size, void* caller, const char* kind, std::size_t alignment = 0) noexcept {
+  static LONG reports = 0;
+  if (InterlockedIncrement(&reports) > 8) return;
+  char buffer[384];
+  int length = std::snprintf(buffer, sizeof(buffer),
+    "BOXEDWINE_DXVK_ALLOCATION_FAILED tid=%lu kind=%s bytes=%lu alignment=%lu caller=%p image=%p\n",
+    static_cast<unsigned long>(GetCurrentThreadId()), kind,
+    static_cast<unsigned long>(size), static_cast<unsigned long>(alignment), caller, &__ImageBase);
+  if (length <= 0) return;
+  DWORD written = 0;
+  WriteFile(GetStdHandle(STD_ERROR_HANDLE), buffer,
+    static_cast<DWORD>(length < int(sizeof(buffer)) ? length : sizeof(buffer) - 1),
+    &written, nullptr);
+}
+
+extern "C" void* __wrap__Znwj(std::size_t size) {
+  try { return __real__Znwj(size); }
+  catch (const std::bad_alloc&) {
+    reportAllocationFailure(size, __builtin_return_address(0), "new");
+    throw;
+  }
+}
+
+extern "C" void* __wrap__Znaj(std::size_t size) {
+  try { return __real__Znaj(size); }
+  catch (const std::bad_alloc&) {
+    reportAllocationFailure(size, __builtin_return_address(0), "new_array");
+    throw;
+  }
+}
+extern "C" void* __wrap__ZnwjSt11align_val_t(std::size_t size, std::align_val_t alignment) {
+  try { return __real__ZnwjSt11align_val_t(size, alignment); }
+  catch (const std::bad_alloc&) {
+    reportAllocationFailure(size, __builtin_return_address(0), "new_aligned", std::size_t(alignment));
+    throw;
+  }
+}
+
+extern "C" void* __wrap__ZnajSt11align_val_t(std::size_t size, std::align_val_t alignment) {
+  try { return __real__ZnajSt11align_val_t(size, alignment); }
+  catch (const std::bad_alloc&) {
+    reportAllocationFailure(size, __builtin_return_address(0), "new_array_aligned", std::size_t(alignment));
+    throw;
+  }
+}
+
+extern "C" void __wrap__ZSt17__throw_bad_allocv() {
+  // Allocator max-size checks may reject a request before operator new.
+  reportAllocationFailure(0, __builtin_return_address(0), "allocator_reject_size_unknown");
+  __real__ZSt17__throw_bad_allocv();
+}
+#endif
