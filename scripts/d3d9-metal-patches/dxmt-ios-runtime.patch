diff --git a/src/util/wsi_platform_win32.cpp b/src/util/wsi_platform_win32.cpp
--- a/src/util/wsi_platform_win32.cpp
+++ b/src/util/wsi_platform_win32.cpp
@@ -4,6 +4,12 @@
 namespace dxmt::wsi {
 
 void *aligned_malloc(size_t size, size_t alignment) {
+#ifdef DXMT_IOS
+  // Guest and host pages have different sizes. Own every host page Metal wires.
+  alignment = alignment < 16384 ? 16384 : alignment;
+  if (size > SIZE_MAX - (alignment - 1)) return nullptr;
+  size = (size + alignment - 1) & ~(alignment - 1);
+#endif
   return _aligned_malloc(size, alignment);
 }
 
