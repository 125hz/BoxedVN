+namespace {
+/* BoxedWine: the native host has no InvalidationTracker, and host-side
+ * conformance runs have no runtime at all. Allow the absolute target to arrive
+ * through the environment as well, read once during static initialization so
+ * no translation is ever in flight and no signal handler is involved. */
+uint64_t BoxedWineIRCapEnvironmentTarget() {
+  const char* Value = getenv("FEX_BOXEDWINE_IRCAP_TARGET");
+  if (!Value || !Value[0]) {
+    return 0;
+  }
+  return strtoull(Value, nullptr, 0);
+}
+const bool BoxedWineIRCapEnvironmentArmed = [] {
+  const uint64_t Target = BoxedWineIRCapEnvironmentTarget();
+  if (Target) {
+    FEX_MythicIRCapTarget = Target;
+  }
+  return Target != 0;
+}();
+} // namespace
