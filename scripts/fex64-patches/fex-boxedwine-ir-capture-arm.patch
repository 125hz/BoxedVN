+/* BoxedWine arming surface. The runtime calls these from ordinary code only --
+ * never from a signal handler, and never while a FEX translation is running --
+ * after it has localized a faulting guest instruction of its own. This does not
+ * replace the capture implementation above; it only publishes its target and
+ * resets the bounded session counter so a later launch can capture afresh. */
+extern "C" void FEX_BoxedWineIRCapArm(uint64_t Target) {
+  FEX_MythicIRCapTarget = Target;
+  IRCapTaken.store(0, std::memory_order_relaxed);
+  IRCapRIP = 0;
+}
+extern "C" void FEX_BoxedWineIRCapDisarm() {
+  FEX_MythicIRCapTarget = 0;
+  IRCapTaken.store(0, std::memory_order_relaxed);
+  IRCapRIP = 0;
+}
+extern "C" uint64_t FEX_BoxedWineIRCapCurrentTarget() {
+  (void)BoxedWineIRCapEnvironmentArmed;
+  return FEX_MythicIRCapTarget;
+}
