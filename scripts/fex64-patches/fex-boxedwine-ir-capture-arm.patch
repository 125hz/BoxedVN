+/* BoxedWine emitter self-test. This lives inside the JIT translation unit on
+ * purpose: it is compiled with the same flags, from the same headers, into the
+ * same libFEXCore.a the application links, so a device-side run proves the
+ * production encoder rather than a host rebuild of it. The encoding under test
+ * is the unscaled 128-bit vector store the device reported as 0xffff0177. */
+extern "C" uint32_t FEX_BoxedWineEmitterSelfTest(uint32_t* ActualOut) {
+  alignas(4) uint8_t Buffer[16] {};
+  ARMEmitter::Emitter Emit(Buffer, sizeof(Buffer));
+  Emit.stur(ARMEmitter::QRegister(23), ARMEmitter::Register(11), -16);
+  uint32_t Word = 0;
+  __builtin_memcpy(&Word, Buffer, sizeof(Word));
+  if (ActualOut) {
+    *ActualOut = Word;
+  }
+  return 0x3c9f0177u;
+}
