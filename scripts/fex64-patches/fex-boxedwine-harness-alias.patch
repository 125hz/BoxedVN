       // failed to map
       LogMan::Msg::EFmt("Failed to map {}-bit elf file.", Loader.Is64BitMode() ? 64 : 32);
       return -ENOEXEC;
     }

+    for (const auto& [Address, Size] : BoxedWineAliased) {
+      std::memcpy(reinterpret_cast<void*>(BoxedWineGuestToHost(Address)), reinterpret_cast<const void*>(Address), Size);
+    }
