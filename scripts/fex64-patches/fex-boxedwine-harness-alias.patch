   CTX->SetSignalDelegator(SignalDelegation.get());
   CTX->SetSyscallHandler(SyscallHandler.get());

+  // BoxedWine's guest address translation, for fixtures that exist to exercise
+  // it. Off unless FEX_BOXEDWINE_ALIAS is set, so every other harness run is
+  // bit-for-bit what it was.
+  //
+  // This exists because a fixture running with the translation disabled cannot
+  // catch a missing translation. The device faulted in the vectorised copy
+  // loop on a canonical top-arena pointer that MemCpy had OR'd but never
+  // relocated, and no harness fixture could have seen it.
+  //
+  // The values match include/guest_low_alias.h. They are literals here because
+  // this tool is built from the FEX tree and has no path to BoxedVN's headers;
+  // the contract test pins the two together.
+  // Empty counts as off: the probe passes the variable on every run and
+  // only sets a value for the fixture that wants it.
+  const char* const BoxedWineAliasEnv = std::getenv("FEX_BOXEDWINE_ALIAS");
+  const bool BoxedWineAlias = BoxedWineAliasEnv != nullptr && BoxedWineAliasEnv[0] != 0 && BoxedWineAliasEnv[0] != '0';
+  constexpr uint64_t BoxedWineLowAliasBase = 0x7800000000ULL;
+  constexpr uint64_t BoxedWineLowGuestLimit = 0x200000000ULL;
+  constexpr uint64_t BoxedWineTopClearMask = 0x7f8000000000ULL;
+  auto BoxedWineGuestToHost = [](uint64_t Address) -> uint64_t {
+    return (Address | BoxedWineLowAliasBase) & ~BoxedWineTopClearMask;
+  };
+  if (BoxedWineAlias) {
+    CTX->SetGuestLowAlias(BoxedWineLowAliasBase, BoxedWineLowGuestLimit);
+    CTX->SetGuestTopClearMask(BoxedWineTopClearMask);
+    LogMan::Msg::IFmt("BOXEDWINE_HARNESS_ALIAS low_base={:#x} limit={:#x} clear_mask={:#x}", BoxedWineLowAliasBase,
+                      BoxedWineLowGuestLimit, BoxedWineTopClearMask);
+  }
+
   if (!CTX->InitCore()) {
     return 1;
   }
