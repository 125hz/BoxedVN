+    // With the translation on, the guest keeps its canonical addresses and the
+    // bytes live at the translated host address -- including the code the
+    // decoder fetches. Map both, and copy each region across afterwards so the
+    // fixture image is present where execution will actually read it.
+    fextl::vector<std::pair<uint64_t, size_t>> BoxedWineAliased;
+    auto MapForFixture = [&](uint64_t Address, size_t Size) -> void* {
+      void* Result = DoMmap(Address, Size);
+      if (BoxedWineAlias) {
+        const uint64_t Host = BoxedWineGuestToHost(Address);
+        if (Host != Address) {
+          DoMmap(Host, Size);
+          BoxedWineAliased.emplace_back(Address, Size);
+        }
+      }
+      return Result;
+    };
+
     // Run through FEX
-    if (!Loader.MapMemory(DoMmap)) {
