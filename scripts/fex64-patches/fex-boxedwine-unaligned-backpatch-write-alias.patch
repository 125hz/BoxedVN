+// BoxedWine: the code buffer is dual-mapped on iOS, where the executable
+// alias is never writable. A backpatch writes through the writable alias,
+// then cleans that alias's data-cache lines before the executable alias's
+// instruction cache is invalidated (the alias that owns the dirty lines is
+// what the cache maintenance has to name).
+static void FlushWriteAlias(void* Begin, std::size_t Length) {
+#if defined(__APPLE__)
+  sys_dcache_flush(FEXCore::DualMap::WriteAddr(Begin), Length);
+#else
+  (void)Begin;
+  (void)Length;
+#endif
+}
+
 static void ClearICache(void* Begin, std::size_t Length) {
   __builtin___clear_cache(static_cast<char*>(Begin), static_cast<char*>(Begin) + Length);
 }
