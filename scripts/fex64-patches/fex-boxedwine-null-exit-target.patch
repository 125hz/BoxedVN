+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP1, &L1Unusable);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP2, &SkipFullLookup);
+
+    /* Key matched but the cached host pointer is null. Because invalidation
