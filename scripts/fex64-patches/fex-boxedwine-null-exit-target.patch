+/* BoxedWine: the bounded witness for an indirect exit that would have branched
+ * to host address zero.
+ *
+ * DEF_OP(ExitFunction)'s emitted L1 lookup compared only the cached GUEST key,
+ * so an empty slot -- {HostCode = 0, GuestCode = 0} -- was a hit for a dynamic
+ * guest target of zero, and the emitted `ret TMP2` branched to host address
+ * zero. A device run does exactly that in the `leave; mov eax, edx; ret`
+ * epilogue of __libc_sigaction: host PC 0, fault address 0, and nothing left in
+ * the report to say what the guest target was, where it came from, or what the
+ * cache actually held.
+ *
+ * The emitted lookup now requires a non-null host pointer and falls into this
+ * path instead. Everything the JIT knew at that moment is either in the frame
+ * (the target, the guest stack pointers) or in the cache entry itself, so the
+ * report is assembled here, where it can be bounded and where it costs nothing
+ * on any path that is working.
+ *
+ * The guest stack is deliberately NOT dereferenced here. The popped qword IS
+ * the dynamic target for a RET, which is reported; re-reading the memory it
+ * came from is what proves whether the pop misread it, and that read has to be
+ * fault-tolerant. BoxedWine's fault reporter does it with a checked read
+ * through its own address space, which is the only side that can tell a mapped
+ * guest page from an unmapped one. */
+namespace {
+std::atomic<uint32_t> BoxedWineNullExitReports {0};
+constexpr uint32_t BoxedWineNullExitReportLimit = 8;
+} // namespace
+
+void ContextImpl::BoxedWineReportNullExitTarget(FEXCore::Core::CpuStateFrame* Frame, uint64_t GuestRIP) {
+  if (!Frame) {
+    return;
+  }
+  const uint64_t Source = Frame->BoxedWineNullExitSource;
+  Frame->BoxedWineNullExitSource = 0;
+  if (Source == 0) {
+    return;
+  }
+  if (BoxedWineNullExitReports.fetch_add(1, std::memory_order_relaxed) >= BoxedWineNullExitReportLimit) {
+    return;
+  }
+
+  /* The cache entry the emitted lookup actually read, re-derived the same way
+   * it derives it: index = (RIP << ilog2(entry size)) & the pre-scaled mask. */
+  uint64_t CachedGuest = 0;
+  uint64_t CachedHost = 0;
+  uint64_t EntryAddress = 0;
+  if (Frame->State.L1Pointer) {
+    EntryAddress = Frame->State.L1Pointer +
+                   ((GuestRIP << FEXCore::ilog2(sizeof(LookupCache::LookupCacheEntry))) & Frame->State.L1Mask);
+    const auto* CacheEntry = reinterpret_cast<const LookupCache::LookupCacheEntry*>(EntryAddress);
+    CachedHost = CacheEntry->HostCode;
+    CachedGuest = CacheEntry->GuestCode;
+  }
+
+  /* A RET has already advanced the guest stack pointer past the qword it
+   * consumed, so the slot it read is one qword below the current RSP. Both the
+   * canonical address and the host address its bytes live at are reported: the
+   * translation is what a wrong lowering would get wrong, and it is pure
+   * arithmetic, so naming it costs nothing and dereferences nothing. */
+  const uint64_t GuestRSP = Frame->State.gregs[FEXCore::X86State::REG_RSP];
+  const uint64_t GuestRBP = Frame->State.gregs[FEXCore::X86State::REG_RBP];
+  const uint64_t PoppedSlot = GuestRSP - 8;
+
+  LogMan::Msg::EFmt("BOXEDWINE_FEX64_NULL_EXIT_TARGET source_block={:#x} guest_target={:#x} host_target={:#x} "
+                    "l1_entry={:#x} l1_key={:#x} l1_host={:#x} rsp_after_pop={:#x} rsp_before_pop={:#x} "
+                    "popped_slot={:#x} popped_slot_host={:#x} rbp={:#x} rbp_host={:#x} return_slot={:#x} "
+                    "return_slot_host={:#x} path={} repeat={}",
+                    Source, GuestRIP, CachedHost, EntryAddress, CachedGuest, CachedHost, GuestRSP, PoppedSlot,
+                    PoppedSlot, GuestToHostAddress(PoppedSlot), GuestRBP, GuestToHostAddress(GuestRBP), GuestRBP + 8,
+                    GuestToHostAddress(GuestRBP + 8), CachedGuest == GuestRIP ? "l1-null-host" : "l1-miss",
+                    BoxedWineNullExitReports.load(std::memory_order_relaxed));
+}
