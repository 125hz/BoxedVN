+// True when this pushed value is a CALL's return address. CALLOp materialises
+// it with _EntrypointOffset; no other push does.
+bool Arm64JITCore::IsCallReturnPush(IR::OrderedNodeWrapper Value) const {
+  if (Value.IsImmediate()) {
+    return false;
+  }
+  const auto Header = IR->GetOp<IR::IROp_Header>(Value);
+  return Header->Op == IR::IROps::OP_ENTRYPOINTOFFSET || Header->Op == IR::IROps::OP_INLINEENTRYPOINTOFFSET;
+}
+
+// Record one CALL return-address push into the frame's ring, and read the slot
+// back through the same host address the store just used.
+//
+// Register budget at the call site: TMP4 holds the translated slot address and
+// must survive; Dst holds the canonical slot and is the guest's new stack
+// pointer, so it must not be touched. `Value` is either an allocated GPR or
+// TMP1, so TMP2 and TMP3 are always free -- and Value is written to memory
+// before TMP1 is used for anything, which makes TMP1 free after that point.
+void Arm64JITCore::EmitCallReturnWitness(ARMEmitter::Register Value, ARMEmitter::Register SlotGuest,
+                                         ARMEmitter::Register SlotHost, ARMEmitter::Register Src,
+                                         ARMEmitter::Register AddrSrc) {
+  using Frame = FEXCore::Core::CpuStateFrame;
+  constexpr uint64_t RecordBytes = sizeof(Frame::BoxedWineCallRecord);
+  constexpr uint64_t RingMask = Frame::BoxedWineCallRingCount - 1;
+
+  // TMP2 = &BoxedWineCallRingIndex, TMP3 = the slot index for this record.
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP2, offsetof(Frame, BoxedWineCallRingIndex));
+  add(ARMEmitter::Size::i64Bit, TMP2, STATE, TMP2);
+  ldr(TMP3, TMP2, 0);
+  add(ARMEmitter::Size::i64Bit, TMP3, TMP3, 1);
+  and_(ARMEmitter::Size::i64Bit, TMP3, TMP3, RingMask);
+  str(TMP3, TMP2, 0);
+
+  // TMP2 = &BoxedWineCallRing[index].
+  lsl(ARMEmitter::Size::i64Bit, TMP3, TMP3, FEXCore::ilog2(RecordBytes));
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP2, offsetof(Frame, BoxedWineCallRing));
+  add(ARMEmitter::Size::i64Bit, TMP2, STATE, TMP2);
+  add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP3);
+
+  // Everything that needs Value goes first, so TMP1 is free afterwards even
+  // when Value is TMP1.
+  str(Value.X(), TMP2, offsetof(Frame::BoxedWineCallRecord, IntendedReturn));
+  str(SlotGuest.X(), TMP2, offsetof(Frame::BoxedWineCallRecord, SlotGuest));
+  str(SlotHost.X(), TMP2, offsetof(Frame::BoxedWineCallRecord, SlotHost));
+  // The stack pointer before the push, derived from the slot rather than read
+  // out of AddrSrc: the lowering may have written the result into the address
+  // register, in which case AddrSrc no longer holds the pre-push value. The
+  // slot is the post-push pointer by construction, so this is exact for every
+  // overlap shape.
+  add(ARMEmitter::Size::i64Bit, TMP3, SlotGuest, 8);
+  str(TMP3, TMP2, offsetof(Frame::BoxedWineCallRecord, StackBefore));
+
+  // The read-back, through the very same host address the store used.
+  ldur(TMP3, SlotHost, 0);
+  str(TMP3, TMP2, offsetof(Frame::BoxedWineCallRecord, Readback));
+
+  // The block that issued the CALL, and the lowering shape it took.
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Entry);
+  str(TMP1, TMP2, offsetof(Frame::BoxedWineCallRecord, SourceBlock));
+
+  // Info: value size in bits 0..7, then one bit per overlap case, so a
+  // register-allocation shape that only occurs on device is still named.
+  uint64_t Info = 8;
+  if (Src == AddrSrc) {
+    Info |= 1ULL << 8;
+  }
+  if (Src == SlotGuest) {
+    Info |= 1ULL << 9;
+  }
+  if (Value != Src) {
+    // The value was copied to a temporary because it overlapped the address or
+    // the result.
+    Info |= 1ULL << 10;
+  }
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Info);
+  str(TMP1, TMP2, offsetof(Frame::BoxedWineCallRecord, Info));
+
+  // A monotonic sequence number, so a wrapped ring can still be ordered.
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, offsetof(Frame, BoxedWineCallSequence));
+  add(ARMEmitter::Size::i64Bit, TMP1, STATE, TMP1);
+  ldr(TMP3, TMP1, 0);
+  add(ARMEmitter::Size::i64Bit, TMP3, TMP3, 1);
+  str(TMP3, TMP1, 0);
+  str(TMP3, TMP2, offsetof(Frame::BoxedWineCallRecord, Sequence));
+
+  // Count a read-back that did not return what was stored. The value is reread
+  // from the record rather than kept live, because TMP1 has been reused.
+  {
+    ARMEmitter::ForwardLabel Matched;
+    ldr(TMP1, TMP2, offsetof(Frame::BoxedWineCallRecord, IntendedReturn));
+    ldr(TMP3, TMP2, offsetof(Frame::BoxedWineCallRecord, Readback));
+    sub(TMP3, TMP3, TMP1);
+    (void)cbz(ARMEmitter::Size::i64Bit, TMP3, &Matched);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, offsetof(Frame, BoxedWineCallAnomalies));
+    add(ARMEmitter::Size::i64Bit, TMP1, STATE, TMP1);
+    ldr(TMP3, TMP1, 0);
+    add(ARMEmitter::Size::i64Bit, TMP3, TMP3, 1);
+    str(TMP3, TMP1, 0);
+    (void)Bind(&Matched);
+  }
+}
