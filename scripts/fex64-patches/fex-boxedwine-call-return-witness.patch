+// True when this pushed value is a CALL's return address. CALLOp materialises
+// it with _EntrypointOffset; no other push does.
+bool Arm64JITCore::IsCallReturnPush(IR::OrderedNodeWrapper Value) const {
+  if (Value.IsImmediate()) {
+    return false;
+  }
+  const auto Header = IR->GetOp<IR::IROp_Header>(Value);
+  return Header->Op == IR::IROps::OP_ENTRYPOINTOFFSET || Header->Op == IR::IROps::OP_INLINEENTRYPOINTOFFSET;
+}
+
+// Record one CALL return-address push into the frame's ring, and read the slot
+// back through the same host address the store just used.
+//
+// Register budget at the call site: TMP4 holds the translated slot address and
+// must survive; Dst holds the canonical slot and is the guest's new stack
+// pointer, so it must not be touched. `Value` is either an allocated GPR or
+// TMP1, so TMP2 and TMP3 are always free -- and Value is written to memory
+// before TMP1 is used for anything, which makes TMP1 free after that point.
+void Arm64JITCore::EmitCallReturnWitness(ARMEmitter::Register Value, ARMEmitter::Register SlotGuest,
+                                         ARMEmitter::Register SlotHost, ARMEmitter::Register Src,
+                                         ARMEmitter::Register AddrSrc) {
+  using Ring = FEXCore::Core::BoxedWineCallRing;
+  using Record = FEXCore::Core::BoxedWineCallRecord;
+  constexpr uint64_t RingMask = Ring::Count - 1;
+
+  /* The ring lives beside the thread; the frame carries only a pointer to it.
+   * Loading that pointer costs one instruction and keeps CpuStateFrame the size
+   * it was -- the frame is addressed by load/store immediates whose range
+   * depends on access width, and a kilobyte of growth pushed an existing
+   * byte-sized access past its 4095-byte limit. */
+  ARMEmitter::ForwardLabel NoRing;
+  ldr(TMP2, STATE, offsetof(FEXCore::Core::CpuStateFrame, BoxedWineCallRingPointer));
+  (void)cbz(ARMEmitter::Size::i64Bit, TMP2, &NoRing);
+
+  // Advance the ring index and turn it into this record's address. Records sit
+  // at offset zero, so the shifted index is the whole displacement.
+  ldr(TMP3, TMP2, offsetof(Ring, Index));
+  add(ARMEmitter::Size::i64Bit, TMP3, TMP3, 1);
+  and_(ARMEmitter::Size::i64Bit, TMP3, TMP3, RingMask);
+  str(TMP3, TMP2, offsetof(Ring, Index));
+  lsl(ARMEmitter::Size::i64Bit, TMP3, TMP3, FEXCore::ilog2(sizeof(Record)));
+
+  // Everything that needs Value goes first: Value may be TMP1, and TMP1 is
+  // needed as scratch below. TMP2 stays the ring base until then.
+  add(ARMEmitter::Size::i64Bit, TMP1, TMP2, TMP3);
+  str(Value.X(), TMP1, offsetof(Record, IntendedReturn));
+  str(SlotGuest.X(), TMP1, offsetof(Record, SlotGuest));
+  str(SlotHost.X(), TMP1, offsetof(Record, SlotHost));
+
+  // The stack pointer before the push, derived from the slot rather than read
+  // out of AddrSrc: the lowering may have written the result into the address
+  // register, in which case AddrSrc no longer holds the pre-push value. The
+  // slot is the post-push pointer by construction, so this is exact for every
+  // overlap shape.
+  add(ARMEmitter::Size::i64Bit, TMP3, SlotGuest, 8);
+  str(TMP3, TMP1, offsetof(Record, StackBefore));
+
+  // The read-back, through the very same host address the store used.
+  ldur(TMP3, SlotHost, 0);
+  str(TMP3, TMP1, offsetof(Record, Readback));
+
+  // The block that issued the CALL, and the lowering shape it took.
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP3, Entry);
+  str(TMP3, TMP1, offsetof(Record, SourceBlock));
+
+  // Info: value size in bits 0..7, then one bit per overlap case, so a
+  // register-allocation shape that only occurs on device is still named.
+  uint64_t Info = 8;
+  if (Src == AddrSrc) {
+    Info |= 1ULL << 8;
+  }
+  if (Src == SlotGuest) {
+    Info |= 1ULL << 9;
+  }
+  if (Value != Src) {
+    // The value was copied to a temporary because it overlapped the address or
+    // the result.
+    Info |= 1ULL << 10;
+  }
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP3, Info);
+  str(TMP3, TMP1, offsetof(Record, Info));
+
+  // A monotonic sequence number, so a wrapped ring can still be ordered.
+  ldr(TMP3, TMP2, offsetof(Ring, Sequence));
+  add(ARMEmitter::Size::i64Bit, TMP3, TMP3, 1);
+  str(TMP3, TMP2, offsetof(Ring, Sequence));
+  str(TMP3, TMP1, offsetof(Record, Sequence));
+
+  // Count a read-back that did not return what was stored. Both values are
+  // reread from the record, because Value may have been TMP1.
+  {
+    ARMEmitter::ForwardLabel Matched;
+    ldr(TMP3, TMP1, offsetof(Record, IntendedReturn));
+    ldr(TMP1, TMP1, offsetof(Record, Readback));
+    sub(TMP3, TMP3, TMP1);
+    (void)cbz(ARMEmitter::Size::i64Bit, TMP3, &Matched);
+    ldr(TMP3, TMP2, offsetof(Ring, Anomalies));
+    add(ARMEmitter::Size::i64Bit, TMP3, TMP3, 1);
+    str(TMP3, TMP2, offsetof(Ring, Anomalies));
+    (void)Bind(&Matched);
+  }
+
+  (void)Bind(&NoRing);
+}
