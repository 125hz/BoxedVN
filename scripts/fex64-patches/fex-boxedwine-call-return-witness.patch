+/* The retained CALL history, printed only because a return has already gone
+ * wrong. Newest first, at most one line per record, at most a few dumps per
+ * run: enough to name the CALL whose return address the failing RET was
+ * supposed to consume, and to say whether that CALL's own read-back agreed
+ * with what it stored. */
+void ContextImpl::BoxedWineDumpCallRing(FEXCore::Core::CpuStateFrame* Frame, const char* Reason) {
+  if (!Frame) {
+    return;
+  }
+  if (BoxedWineCallRingDumps.fetch_add(1, std::memory_order_relaxed) >= BoxedWineCallRingDumpLimit) {
+    return;
+  }
+  LogMan::Msg::EFmt("BOXEDWINE_FEX64_CALL_RING reason={} recorded={} anomalies={} armed={}", Reason,
+                    Frame->BoxedWineCallSequence, Frame->BoxedWineCallAnomalies, BoxedWineCallWitness ? 1 : 0);
+  const uint64_t Count = FEXCore::Core::CpuStateFrame::BoxedWineCallRingCount;
+  for (uint64_t Step = 0; Step < Count; ++Step) {
+    // Newest first.
+    const uint64_t Index = (Frame->BoxedWineCallRingIndex + Count - Step) % Count;
+    const auto& Record = Frame->BoxedWineCallRing[Index];
+    if (Record.Sequence == 0) {
+      continue;
+    }
+    LogMan::Msg::EFmt("BOXEDWINE_FEX64_CALL_RECORD seq={} source_block={:#x} intended_return={:#x} "
+                      "slot_guest={:#x} slot_host={:#x} readback={:#x} match={} stack_before={:#x} "
+                      "value_size={} overlap_src_addr={} overlap_src_dst={} value_copied={}",
+                      Record.Sequence, Record.SourceBlock, Record.IntendedReturn, Record.SlotGuest, Record.SlotHost,
+                      Record.Readback, Record.Readback == Record.IntendedReturn ? 1 : 0, Record.StackBefore,
+                      Record.Info & 0xFF, (Record.Info >> 8) & 1, (Record.Info >> 9) & 1, (Record.Info >> 10) & 1);
+  }
+}
