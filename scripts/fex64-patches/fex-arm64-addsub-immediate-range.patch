+/* The add/sub immediate form encodes an UNSIGNED twelve-bit value, optionally
+ * shifted left by twelve. An inline constant outside that range -- a negative
+ * displacement such as `lea rbx, [rdi - 0x40]`, which reaches the backend as
+ * 0xffffffffffffffc0 -- was still handed to the immediate emitter, whose
+ * parameter is uint32_t. With assertions compiled out the oversized value was
+ * shifted straight into the opcode field and produced an invalid instruction.
+ *
+ * Masking the immediate would be worse than the fault: it would turn -64 into
+ * a positive displacement and silently corrupt guest results. Materialize the
+ * constant instead and use the ordinary register form, which is exact for both
+ * the plain and the flag-setting operations. The inline-constant IR node never
+ * receives a register of its own -- register allocation skips it entirely --
+ * so a scratch register, not GetReg(Op->Src2), is what the register form has
+ * to consume here. */
+#define DEF_ADDSUB_WITH_CONSTANT(FEXOp, VarOp, ConstOp)                                    \
+  DEF_OP(FEXOp) {                                                                          \
+    auto Op = IROp->C<IR::IROp_##FEXOp>();                                                 \
+                                                                                           \
+    uint64_t Const;                                                                        \
