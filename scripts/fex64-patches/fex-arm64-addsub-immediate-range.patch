+      }                                                                                    \
+    } else {                                                                               \
+      VarOp(ConvertSize(IROp), GetReg(Node), GetZeroableReg(Op->Src1), GetReg(Op->Src2));  \
+    }                                                                                      \
+  }
+
+DEF_ADDSUB_WITH_CONSTANT(Add, add, add)
