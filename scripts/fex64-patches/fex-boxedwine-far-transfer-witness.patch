+void BoxedWineNoteGuestFarTransfer(uint64_t GuestRIP, const char* Kind) {
+  if (BoxedWineFarTransferReports.load(std::memory_order_acquire) >= BoxedWineFarTransferReportLimit) {
+    return;
+  }
+  BoxedWineFarTransferKind.store(Kind, std::memory_order_relaxed);
+  BoxedWineFarTransferRip.store(GuestRIP, std::memory_order_release);
+  LogMan::Msg::IFmt("BOXEDWINE_FEX64_FAR_TRANSFER_PRE kind={} rip={:#x}", Kind ? Kind : "far", GuestRIP);
+}
+
+uint64_t BoxedWineTakeGuestFarTransferNote(const char** Kind) {
+  const uint64_t From = BoxedWineFarTransferRip.exchange(0, std::memory_order_acq_rel);
+  if (From == 0) {
+    return 0;
+  }
+  BoxedWineFarTransferReports.fetch_add(1, std::memory_order_acq_rel);
+  if (Kind != nullptr) {
+    const char* const Stored = BoxedWineFarTransferKind.load(std::memory_order_acquire);
+    if (Stored != nullptr) {
+      *Kind = Stored;
+    }
+  }
+  return From;
+}
