 public:
   // Context base class implementation.
   bool InitCore() override;
+  void SetGuestLowAlias(uint64_t Base, uint64_t Limit) override {
+    // Published once, before any guest code is translated. The translation is
+    // applied only at host dereference boundaries: guest RIPs, GPR values,
+    // syscall arguments, code-cache keys and invalidation keys stay canonical.
+    GuestLowAliasBase = Base;
+    GuestLowAliasLimit = Limit;
+  }
+  void SetGuestTopClearMask(uint64_t Mask) override {
+    // Wine's top-down arena is the one lane the OR cannot reach: those guest
+    // addresses already carry the alias base's bits, so the OR is the identity
+    // there and the host would have to map the arena at its own address. Every
+    // address in the arena has this bit field set and every other hostable
+    // guest address has it clear, so clearing the field relocates the arena and
+    // does nothing anywhere else. It is one extra flag-free instruction, which
+    // matters: guest arithmetic flags live in the host NZCV register, so a
+    // compare-and-select inside operand generation would corrupt them.
+    GuestTopClearMask = Mask;
+  }
+  uint64_t GetGuestLowAliasBase() const {
+    return GuestLowAliasBase;
+  }
+  uint64_t GetGuestTopClearMask() const {
+    return GuestTopClearMask;
+  }
+  // Canonical guest address to the host address its bytes live at. The alias
+  // base is chosen so the OR is addition for canonical low addresses and the
+  // identity for every permitted high address; the mask relocates the top
+  // arena and is a no-op everywhere else.
+  uint64_t GuestToHostAddress(uint64_t GuestAddress) const {
+    return (GuestAddress | GuestLowAliasBase) & ~GuestTopClearMask;
+  }

   void ExecuteThread(FEXCore::Core::InternalThreadState* Thread) override;

