+  void SetGuestLowAlias(uint64_t Base, uint64_t Limit) override {
+    // Published once, before any guest code is translated. The translation is
+    // applied only at host dereference boundaries: guest RIPs, GPR values,
+    // syscall arguments, code-cache keys and invalidation keys stay canonical.
+    GuestLowAliasBase = Base;
+    GuestLowAliasLimit = Limit;
+  }
+  uint64_t GetGuestLowAliasBase() const {
+    return GuestLowAliasBase;
+  }
+  // Canonical guest address to the host address its bytes live at. The alias
+  // base is chosen so this single OR is addition for canonical low addresses
+  // and the identity for every permitted high address.
+  uint64_t GuestToHostAddress(uint64_t GuestAddress) const {
+    return GuestAddress | GuestLowAliasBase;
+  }

