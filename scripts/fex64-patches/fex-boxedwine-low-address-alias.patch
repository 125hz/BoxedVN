+ARMEmitter::Register Arm64JITCore::AliasGuestAddress(ARMEmitter::Register Base) {
+  const uint64_t AliasBase = CTX->GetGuestLowAliasBase();
+  if (AliasBase == 0) {
+    return Base;
+  }
+  // The alias base is a single contiguous run of ones, so it encodes directly
+  // as an ARM64 logical immediate and needs no constant materialisation.
+  orr(ARMEmitter::Size::i64Bit, TMP4, Base, AliasBase);
+  return TMP4;
+}
