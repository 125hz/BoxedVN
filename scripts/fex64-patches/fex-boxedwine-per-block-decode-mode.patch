+void ContextImpl::BoxedWineNoteDecodeMode(uint64_t GuestRIP, uint16_t CSIndex, bool Is64BitMode) {
+  const uint32_t Mode = Is64BitMode ? 1u : 2u;
+  const uint32_t Previous = BoxedWineDecodeMode.exchange(Mode, std::memory_order_acq_rel);
+  if (Previous == Mode || Previous == 0) {
