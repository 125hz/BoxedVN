+  if (BoxedWineDecodeModeReports.fetch_add(1, std::memory_order_relaxed) >= BoxedWineDecodeModeReportLimit) {
+    return;
+  }
+  LogMan::Msg::IFmt("BOXEDWINE_FEX64_MODE_SWITCH rip={:#x} cs={:#x} mode={}", GuestRIP, CSIndex, Is64BitMode ? 64 : 32);
+}
+
+bool ContextImpl::BoxedWineClaimDecodeModePage(uint64_t GuestRIP, bool Is64BitMode) {
+  const uint64_t Page = GuestRIP & FEXCore::Utils::FEX_PAGE_MASK;
+  const uint8_t Mode = Is64BitMode ? 1 : 2;
+  std::scoped_lock lk {BoxedWineDecodeModePagesMutex};
+  auto Existing = BoxedWineDecodeModePages.find(Page);
+  if (Existing == BoxedWineDecodeModePages.end()) {
+    BoxedWineDecodeModePages.emplace(Page, Mode);
+    return false;
+  }
+  if (Existing->second == Mode) {
+    return false;
+  }
+  Existing->second = Mode;
+  return true;
+}
