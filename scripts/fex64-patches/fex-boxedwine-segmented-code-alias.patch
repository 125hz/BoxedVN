diff --git a/FEXCore/include/FEXCore/Utils/DualMap.h b/FEXCore/include/FEXCore/Utils/DualMap.h
--- a/FEXCore/include/FEXCore/Utils/DualMap.h
+++ b/FEXCore/include/FEXCore/Utils/DualMap.h
@@ -16,17 +16,28 @@
 // Source/Windows/ARM64EC/Module.cpp and is set early in ProcessInit
 // (before InitCore, so dispatcher emit picks it up).
 extern int64_t WriteOffset;
+#if defined(__APPLE__)
+// Installed once before translation; each published RX segment has its own RW alias.
+extern int64_t (*WriteOffsetLookup)(const void*);
+#endif
+inline int64_t OffsetFor(const void* Address) {
+#if defined(__APPLE__)
+  if (WriteOffsetLookup) return WriteOffsetLookup(Address);
+#endif
+  return WriteOffset;
+}
 
 inline void* WriteAddr(void* RXAddr) {
-  return reinterpret_cast<uint8_t*>(RXAddr) + WriteOffset;
+  return reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(RXAddr) + OffsetFor(RXAddr));
 }
 
 template<typename T>
 inline T* WriteAddr(T* RXAddr) {
-  return reinterpret_cast<T*>(reinterpret_cast<uint8_t*>(RXAddr) + WriteOffset);
+  return reinterpret_cast<T*>(reinterpret_cast<uintptr_t>(RXAddr) + OffsetFor(RXAddr));
 }
 #else
 static constexpr int64_t WriteOffset = 0;
+inline int64_t OffsetFor(const void*) { return 0; }
 
 inline void* WriteAddr(void* Addr) { return Addr; }
 
