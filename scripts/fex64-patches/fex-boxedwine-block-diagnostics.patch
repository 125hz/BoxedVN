diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 92305f460..50c8cf656 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -1360,4 +1360,24 @@
 uintptr_t ContextImpl::CompileBlock(FEXCore::Core::CpuStateFrame* Frame, uint64_t GuestRIP, uint64_t MaxInst) {
+  /* BoxedWine: keep a bounded enter/leave trace around the whole compiler.
+   * An unmatched enter identifies a translator-side stall, while a matched
+   * pair followed by silence identifies guest execution that did not return to
+   * the dispatcher. This intentionally trades a little startup time for a
+   * deterministic device log during backend bring-up. */
+  static std::atomic<uint32_t> BoxedWineCompileOrdinal {0};
+  const uint32_t BoxedWineOrdinal = BoxedWineCompileOrdinal.fetch_add(1, std::memory_order_relaxed);
+  struct BoxedWineCompileTrace final {
+    uint32_t Ordinal;
+    uint64_t RIP;
+    ~BoxedWineCompileTrace() {
+      if (Ordinal < 128) {
+        LogMan::Msg::IFmt("[boxedwine-block] leave ordinal={} rip={:#x}", Ordinal, RIP);
+      }
+    }
+  } BoxedWineTrace {BoxedWineOrdinal, GuestRIP};
+  if (BoxedWineOrdinal < 128) {
+    LogMan::Msg::IFmt("[boxedwine-block] enter ordinal={} rip={:#x} max_inst={}", BoxedWineOrdinal, GuestRIP, MaxInst);
+  }
+
   if constexpr (BLOCK_DEBUGGING) {
     // Block debugging logic is hand-written and needs to be handled with care.
     // Force MaxInst to only be one in this case.
@@ -1571,11 +1591,14 @@ uintptr_t ContextImpl::CompileBlock(FEXCore::Core::CpuStateFrame* Frame, uint64_
    *
    * Back to IsAddressInCodeBuffer alone, which is sound with no discrimination needed: FEX's own
    * emitted code is never guest code under any classification. */
-  if (GuestRIP >= 0x7400000000ULL || RIPInFEXCodeBuffer) {
+  /* BoxedWine deliberately identity-maps guest ELF images in a guarded high
+   * address window, so a high numeric address alone is not evidence of a host
+   * pointer leak. The precise code-buffer membership test remains valid. */
+  if (RIPInFEXCodeBuffer) {
     static uint32_t BogusRIPCount = 0;
     if (BogusRIPCount < 16) {
       BogusRIPCount++;
       LogMan::Msg::EFmt("[iOS-bogusrip] band={} GuestRIP={:#x} State.rip={:#x} host_ret={} callret_sp={:#x}",
-                        RIPInFEXCodeBuffer ? "FEX-CODE-BUFFER(host PC leak)" : "host-heap(0x7c-0x7f)",
+                        "FEX-CODE-BUFFER(host PC leak)",
                         GuestRIP, Frame ? Frame->State.rip : 0, __builtin_return_address(0),
                         Frame ? Frame->State.callret_sp : 0);
