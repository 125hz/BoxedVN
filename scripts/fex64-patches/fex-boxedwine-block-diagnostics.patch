+namespace FEXCore::Context {
+namespace {
+std::atomic<uint32_t> BoxedWineBlockTraceBudget {0};
+std::atomic<uint32_t> BoxedWineBlockTraceProcess {0};
+std::atomic<uint64_t> BoxedWineIRETRip {0};
+} // namespace
+
+void BoxedWineArmBlockTrace(uint32_t ProcessId, uint32_t Budget) {
+  BoxedWineBlockTraceProcess.store(ProcessId, std::memory_order_relaxed);
+  BoxedWineBlockTraceBudget.store(Budget, std::memory_order_release);
+}
+
+bool BoxedWineDisarmBlockTrace(uint32_t ProcessId) {
+  if (BoxedWineBlockTraceProcess.load(std::memory_order_relaxed) != ProcessId) {
+    return false;
+  }
+  return BoxedWineBlockTraceBudget.exchange(0, std::memory_order_acq_rel) != 0;
+}
+
+void BoxedWineNoteGuestIRET(uint64_t GuestRIP) {
+  if (BoxedWineBlockTraceBudget.load(std::memory_order_acquire) == 0) {
+    return;
+  }
+  BoxedWineIRETRip.store(GuestRIP, std::memory_order_release);
+  LogMan::Msg::IFmt("BOXEDWINE_FEX64_IRET_PRE rip={:#x}", GuestRIP);
+}
+
+uint64_t BoxedWineTakeGuestIRETNote() {
+  return BoxedWineIRETRip.exchange(0, std::memory_order_acq_rel);
+}
+
+bool BoxedWineTakeBlockTraceCredit() {
+  uint32_t Remaining = BoxedWineBlockTraceBudget.load(std::memory_order_acquire);
+  while (Remaining != 0) {
+    if (BoxedWineBlockTraceBudget.compare_exchange_weak(Remaining, Remaining - 1, std::memory_order_acq_rel,
+                                                        std::memory_order_acquire)) {
+      return true;
+    }
+  }
+  return false;
+}
+} // namespace FEXCore::Context
