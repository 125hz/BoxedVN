+// BoxedWine: arm the translator's block trace for a bounded number of blocks.
+// The startup budget is spent long before the transition worth watching, and a
+// permanent per-block trace is a firehose, so this is a phase with an explicit
+// budget that disarms itself when the budget runs out.
+FEX_DEFAULT_VISIBILITY void BoxedWineArmBlockTrace(uint32_t ProcessId, uint32_t Budget);
+// Returns true when it actually stopped something that was armed.
+FEX_DEFAULT_VISIBILITY bool BoxedWineDisarmBlockTrace(uint32_t ProcessId);
+// Consumes one credit; true while the phase is armed.
+FEX_DEFAULT_VISIBILITY bool BoxedWineTakeBlockTraceCredit();
+// Records that an iretq was translated at this guest address, while the phase
+// is armed. Wine enters Windows code through one, and no device log has ever
+// shown that instruction being reached.
+FEX_DEFAULT_VISIBILITY void BoxedWineNoteGuestIRET(uint64_t GuestRIP);
+// Returns and clears the address a pending iretq was translated at, or zero.
+FEX_DEFAULT_VISIBILITY uint64_t BoxedWineTakeGuestIRETNote();

