   // We don't currently support FS/GS selector modifying, so this needs to be asserted out
   // The loads here also load the selector, NOT the base
 
+  // BoxedWine mirrors the small GDT in CPUState so ordinary TLS selector
+  // reloads can use host context loads instead of a signal and guest restart.
+  // Only present ring-3 data descriptors in that mirror qualify. Everything
+  // else keeps the existing host-served path, including LDT and null selectors.
+  auto WriteHostedSelector = [&](Ref Selector, bool FS) {
+    const auto SelectorOffset = FS ? offsetof(Core::CPUState, fs_idx) : offsetof(Core::CPUState, gs_idx);
+    const auto BaseOffset = FS ? offsetof(Core::CPUState, fs_cached) : offsetof(Core::CPUState, gs_cached);
+    _StoreContextGPR(OpSize::i16Bit, Selector, SelectorOffset);
+    Ref FastBlock {};
+    if (CTX->GetGuestLowAliasBase() != 0) {
+      auto Index = _Bfe(OpSize::i32Bit, 5, 3, Selector);
+      auto Descriptor = _LoadContextGPRIndexed(Index, OpSize::i64Bit, offsetof(Core::CPUState, private_gdt), 8);
+      auto Access = _Bfe(OpSize::i64Bit, 8, 40, Descriptor);
+      // Select lowers to a host CMP and clobbers guest NZCV. Zero-test an
+      // OR of mismatches instead: AND/XOR/OR and CBZ preserve those flags.
+      auto SelectorMismatch = _Xor(OpSize::i32Bit,
+          _And(OpSize::i32Bit, Selector, Constant(0xff07)), Constant(3));
+      auto DescriptorMismatch = _Xor(OpSize::i32Bit,
+          _And(OpSize::i32Bit, Access, Constant(0xf8)), Constant(0xf0));
+      auto Invalid = _Or(OpSize::i32Bit, SelectorMismatch, DescriptorMismatch);
+      FastBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+      auto SlowBlock = CreateNewCodeBlockAtEnd();
+      CondJump(Invalid, Constant(0), FastBlock, SlowBlock, CondClass::EQ, OpSize::i32Bit);
+      SetCurrentCodeBlock(SlowBlock);
+      StartNewBlock();
+    }
+    _StoreContextGPR(GetGPROpSize(), GetRelocatedPC(Op, -Op->InstSize), offsetof(Core::CPUState, rip));
+    Break(IR::BreakDefinition {
+      .ErrorRegister = 0, .Signal = Core::FAULT_SIGSEGV,
+      .TrapNumber = X86State::X86_TRAPNO_GP, .si_code = 0x80,
+    });
+    if (FastBlock) {
+      // Complete the fallback CFG block; Break transfers control to the host.
+      ExitRelocatedPC(Op, -Op->InstSize);
+      SetCurrentCodeBlock(FastBlock);
+      StartNewBlock();
+      // FEX allocates SSA temporaries within each block. Reload from the
+      // stored selector instead of carrying Descriptor across this branch.
+      auto StoredSelector = _LoadContextGPR(OpSize::i16Bit, SelectorOffset);
+      auto Index = _Bfe(OpSize::i32Bit, 5, 3, StoredSelector);
+      auto Descriptor = _LoadContextGPRIndexed(Index, OpSize::i64Bit, offsetof(Core::CPUState, private_gdt), 8);
+      auto Upper = _Lshr(OpSize::i64Bit, Descriptor, Constant(32));
+      auto HighBase = _And(OpSize::i32Bit, Upper, Constant(0xff000000));
+      auto Merged = _Orlshr(OpSize::i32Bit, HighBase, Descriptor, 16);
+      auto Base = _Bfi(OpSize::i32Bit, 8, 16, Merged, Upper);
+      // A selector reload replaces the entire base, including an old 64-bit
+      // arch_prctl/WRFSBASE value. It does not alter guest arithmetic flags.
+      _StoreContextGPR(OpSize::i64Bit, _Bfe(OpSize::i64Bit, 32, 0, Base), BaseOffset);
+    }
+  };
+
   if (ToSeg) {
     Ref Src = LoadSourceGPR_WithOpSize(Op, Op->Src[0], OpSize::i16Bit, Op->Flags);
 
