diff --git a/src/dxmt/dxmt_guest_placed.hpp b/src/dxmt/dxmt_guest_placed.hpp
new file mode 100644
index 0000000..e85b70c
--- /dev/null
+++ b/src/dxmt/dxmt_guest_placed.hpp
@@ -0,0 +1,73 @@
+#pragma once
+
+/*
+ * BoxedVN: memory a mapped resource hands to the application must be memory
+ * the guest can address.
+ *
+ * DXMT normally lets Metal own the storage of a CPU-visible buffer and hands
+ * the pointer Metal reports (MTLBuffer.contents) straight back to the caller
+ * of ID3D11DeviceContext::Map. That is correct when the caller and Metal share
+ * one address space. It is not correct when the caller is emulated: the
+ * pointer is a host allocation of the emulator process, and the guest has no
+ * mapping for it, so the first write through a mapped D3D11_USAGE_DYNAMIC
+ * buffer faults.
+ *
+ * Upstream already solves this for the 32-bit guest, where a host pointer may
+ * simply not be representable: BufferAllocationFlag::CpuPlaced makes the guest
+ * allocate the storage itself and Metal wrap it with newBufferWithBytesNoCopy.
+ * The same is required, for the same reason, of a 64-bit guest whose address
+ * space is not the host's. This header decides when that applies and with what
+ * alignment; nothing about the mechanism changes.
+ *
+ * The condition is the build, not the word size: the guest PE build for this
+ * port is the x86-64 target that also defines DXMT_IOS (the native half of the
+ * same port defines DXMT_NATIVE and is compiled for arm64). Define
+ * DXMT_GUEST_PLACED_MEMORY on the command line to force it on elsewhere.
+ */
+
+#include <cstddef>
+
+#ifndef DXMT_PAGE_SIZE
+#define DXMT_PAGE_SIZE 4096
+#endif
+
+#if defined(__i386__)
+/* Upstream's own case; keep its alignment exactly as it was. */
+#define DXMT_GUEST_PLACED_MEMORY 1
+#define DXMT_GUEST_PLACED_ALIGNMENT ((size_t)DXMT_PAGE_SIZE)
+#elif defined(DXMT_IOS) && defined(__x86_64__) && !defined(DXMT_NATIVE)
+#define DXMT_GUEST_PLACED_MEMORY 1
+/*
+ * newBufferWithBytesNoCopy requires a host-page-aligned pointer, and an iOS
+ * device page is 16 KiB while DXMT_PAGE_SIZE is 4 KiB. The emulator's guest
+ * to host translation only sets high bits, so aligning the guest pointer
+ * aligns the host address the bytes actually live at.
+ */
+#define DXMT_GUEST_PLACED_ALIGNMENT ((size_t)16384)
+#else
+#define DXMT_GUEST_PLACED_ALIGNMENT ((size_t)DXMT_PAGE_SIZE)
+#endif
+
+/*
+ * The page a suballocating allocation carves up. Tied to the placement
+ * alignment so one placed page is exactly one host page: leaving it at 4 KiB
+ * and rounding the allocation up to 16 KiB would throw away the difference on
+ * every dynamic buffer, and these are allocated per frame. Identical to
+ * DXMT_PAGE_SIZE wherever placement is not in play.
+ */
+#define DXMT_SUBALLOCATION_PAGE_SIZE DXMT_GUEST_PLACED_ALIGNMENT
+
+namespace dxmt {
+
+/*
+ * Metal wires whole pages of a no-copy buffer, so a placed allocation owns
+ * every page it starts. Rounding the request up keeps those pages ours
+ * instead of borrowing whatever the allocator put next.
+ */
+inline size_t
+guest_placed_size(size_t length) {
+  const size_t alignment = DXMT_GUEST_PLACED_ALIGNMENT;
+  return (length + alignment - 1) & ~(alignment - 1);
+}
+
+} // namespace dxmt
