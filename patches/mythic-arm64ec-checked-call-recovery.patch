+                            mach_vm_read_overwrite(mach_task_self(),
+                                (mach_vm_address_t)state.__x[0], sizeof(object_vtable),
+                                (mach_vm_address_t)&object_vtable, &object_read);
+                            if (object_read == sizeof(object_vtable))
