+                        expected_class = (uint32_t)ci;
+                        class_matches++;
+                    }
+                }
+                mach_vm_read_overwrite(mach_task_self(),
+                    (mach_vm_address_t)(thread_teb + 0x1788), sizeof(cpu_area),
