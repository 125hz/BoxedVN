+             * checked-call cell below.  Later null-target recoveries use it
+             * to avoid treating an unrelated ARM64EC indirect call as FEX. */
+            static uintptr_t boxedvn_early_context_object;
+
+            /* BoxedVN: the pinned ARM64EC FEX binary occasionally reaches
+             * rpmalloc's available-page path with page->size_class replaced
+             * by the low 32 bits of a block pointer.  The allocator detects
+             * this immediately ([rpm-avail] CORRUPT), but the prebuilt DLL
+             * only reports it and then indexes heap->local_free with the bad
+             * value.  That read leaves Wine's address space and the following
+             * exception cannot be dispatched because ThreadInit has not yet
+             * published StateFrame/ThreadState/EnterEC.
+             *
+             * Recover only the pinned instruction whose full relationship is
+             * independently checkable: libarm64ecfex+0x14bef0 is
+             *
+             *   ldr x9,[x20,#0x28] ; page->heap
+             *   ldr w8,[x20]       ; page->size_class
+             *   add x9,x9,#8       ; heap->local_free
+             *   ldr x10,[x9,x8,lsl #3]
+             *
+             * x17 still holds the caller's validated size class.  Require the
+             * exact four instructions, PE RVA, 64 KiB page base, heap pointer,
+             * computed fault address, an implausible current class, and a
+             * small expected class before changing anything.  Repair the
+             * four-byte header and x8, then retry the faulting load.  Any
+             * different allocator fault stays unhandled and visible. */
