diff --git a/build/ntdll-unix/signal_arm64_ios.c b/build/ntdll-unix/signal_arm64_ios.c
index 0d0e5fa..2a2ce74 100644
--- a/build/ntdll-unix/signal_arm64_ios.c
+++ b/build/ntdll-unix/signal_arm64_ios.c
@@ -1784,0 +1785,285 @@ static void *ios_mach_exception_thread( void *arg )
+            /* BoxedVN: finish checked ARM64EC calls that FEX's private checker
+             * deliberately leaves unresolved.
+             *
+             * FEX replaces Wine's general arm64x_check_call with CheckCall,
+             * which only redirects ntdll fast-forward sequences through its
+             * redirection LUT. FEXCore's own virtual functions still use the
+             * canonical 14-byte ARM64EC fast-forward sequence. Before ThreadInit
+             * has installed a guest CPU state, sending one of those through the
+             * x64 dispatcher branches through a zero EnterEC pointer and turns a
+             * single call into an exception/stack-overflow loop.
+             *
+             * The fault itself gives us a precise, side-effect-free recovery
+             * point: BLR x11 has already installed the native return address in
+             * LR, x11 is the non-executable FFS, and x10 is the module's x64 exit
+             * thunk. Decode the same FFS form Wine's checker recognizes and
+             * resume at its ARM64EC target, preserving every argument register
+             * and LR. Only genuine x64 targets, and only after ThreadInit made
+             * the dispatcher usable, take the old x9/x10 route. */
+            if (!handled && fault_addr == (uintptr_t)__darwin_arm_thread_state64_get_pc(state) &&
+                fault_addr >= 0x100000000ULL && state.__x[11] == fault_addr)
+            {
+                extern void *ios_jit_rx_base_global;
+                extern size_t ios_jit_pool_size_global;
+                extern int ios_jit_addr_is_text(uintptr_t addr);
+                extern void *ios_jit_translate_addr_for_owner(void *addr, void *owner_peb);
+                uintptr_t rx = (uintptr_t)ios_jit_rx_base_global;
+                uintptr_t dispatcher = (uintptr_t)state.__x[10];
+                uintptr_t lr = (uintptr_t)state.__lr;
+                uint32_t caller_insn = 0;
+                unsigned char ffs[14];
+                mach_vm_size_t ffs_read = 0;
+
+                if (lr >= rx + 4 && lr < rx + ios_jit_pool_size_global)
+                {
+                    mach_vm_size_t insn_read = 0;
+                    mach_vm_read_overwrite(mach_task_self(), (mach_vm_address_t)(lr - 4),
+                                           sizeof(caller_insn), (mach_vm_address_t)&caller_insn,
+                                           &insn_read);
+                    if (insn_read != sizeof(caller_insn)) caller_insn = 0;
+                }
+
+                if (rx && dispatcher >= rx &&
+                    dispatcher < rx + ios_jit_pool_size_global &&
+                    ios_jit_addr_is_text(dispatcher) &&
+                    caller_insn == 0xd63f0160u)  /* blr x11 */
+                {
+                    static const unsigned char ffs_prefix[10] = {
+                        0x48, 0x8b, 0xc4, 0x48, 0x89, 0x58, 0x20, 0x55, 0x5d, 0xe9
+                    };
+                    mach_vm_read_overwrite(mach_task_self(), (mach_vm_address_t)fault_addr,
+                                           sizeof(ffs), (mach_vm_address_t)ffs, &ffs_read);
+
+                    if (ffs_read == sizeof(ffs) && !memcmp(ffs, ffs_prefix, sizeof(ffs_prefix)))
+                    {
+                        int32_t rel32;
+                        uintptr_t native_target;
+                        uintptr_t resume_target;
+                        static volatile int ffs_recoveries;
+                        int n;
+
+                        memcpy(&rel32, ffs + 10, sizeof(rel32));
+                        native_target = fault_addr + sizeof(ffs) + (intptr_t)rel32;
+                        resume_target = (uintptr_t)ios_jit_translate_addr_for_owner(
+                            (void *)native_target, thread_teb ? ((TEB *)thread_teb)->Peb : NULL);
+                        if (!resume_target) resume_target = native_target;
+
+                        n = __sync_add_and_fetch(&ffs_recoveries, 1);
+                        __darwin_arm_thread_state64_set_pc_fptr(state, (void *)resume_target);
+                        handled = 1;
+                        if (n <= 16 || !(n & 255))
+                            dprintf(STDERR_FILENO,
+                                "[ec-check-ffs] #%d ffs=%p rel=%d native=%p resume=%p "
+                                "lr=%p -- direct ARM64EC call\n",
+                                n, (void *)fault_addr, rel32, (void *)native_target,
+                                (void *)resume_target, (void *)lr);
+                    }
+                    else
+                    {
+                        /* The iOS image clone can contain a stale relocated vtable
+                         * entry even though the original PE vtable is correct.  The
+                         * resulting value points into FEX's RW guest band, so executing
+                         * it faults before ThreadInit exists.  Recover the vtable from
+                         * the object, reverse-map its executable clone to the original
+                         * PE page, and re-read the same slot there. */
+                        extern uint64_t ios_jit_reverse_translate(uint64_t addr,
+                                                                  uint64_t *module_base);
+                        uintptr_t object_vtable = 0, pe_vtable = 0, pe_module = 0;
+                        uintptr_t native_entry = 0, resume_entry = 0;
+                        uint64_t caller_pe = 0, caller_module = 0;
+                        uint64_t cell_words[2] = {0};
+                        uint32_t vtable_load = 0, check_load = 0, check_call = 0;
+                        mach_vm_size_t object_read = 0, slot_read = 0, cell_read = 0;
+                        mach_vm_size_t sequence_read = 0;
+                        uintptr_t slot_offset = 0;
+                        uint32_t call_window[7] = {0};
+                        int call_index;
+
+                        if (lr >= rx + sizeof(call_window))
+                            mach_vm_read_overwrite(mach_task_self(),
+                                (mach_vm_address_t)(lr - sizeof(call_window)),
+                                sizeof(call_window), (mach_vm_address_t)call_window,
+                                &sequence_read);
+                        if (sequence_read == sizeof(call_window) &&
+                            call_window[6] == 0xd63f0160u)
+                        {
+                            /* CheckCall may be followed by argument-register moves before
+                             * the actual BLR x11.  Find the ordered three-instruction
+                             * checker sequence in the bounded seven-instruction window. */
+                            for (call_index = 0; call_index <= 3; call_index++)
+                            {
+                                if ((call_window[call_index] & 0xffc003ffu) == 0xf940010bu &&
+                                    call_window[call_index + 1] == 0xf9400348u &&
+                                    call_window[call_index + 2] == 0xd63f0100u)
+                                {
+                                    vtable_load = call_window[call_index];
+                                    check_load = call_window[call_index + 1];
+                                    check_call = call_window[call_index + 2];
+                                    slot_offset = ((vtable_load >> 10) & 0xfffu) * 8;
+                                    break;
+                                }
+                            }
+                        }
+
+                        /* ldr x11,[x8,#imm12*8]; ldr x8,[x26]; blr x8; blr x11 */
+                        if (sequence_read == sizeof(call_window) && slot_offset &&
+                            check_load == 0xf9400348u && check_call == 0xd63f0100u)
+                        {
+                            mach_vm_read_overwrite(mach_task_self(),
+                                (mach_vm_address_t)state.__x[0], sizeof(object_vtable),
+                                (mach_vm_address_t)&object_vtable, &object_read);
+                            if (object_read == sizeof(object_vtable))
+                                pe_vtable = (uintptr_t)ios_jit_reverse_translate(
+                                    object_vtable, (uint64_t *)&pe_module);
+                            if (pe_vtable && pe_module && slot_offset < 0x10000)
+                                mach_vm_read_overwrite(mach_task_self(),
+                                    (mach_vm_address_t)(pe_vtable + slot_offset),
+                                    sizeof(native_entry), (mach_vm_address_t)&native_entry,
+                                    &slot_read);
+                            if (slot_read == sizeof(native_entry) &&
+                                native_entry >= pe_module &&
+                                native_entry < pe_module + 0x10000000ULL)
+                            {
+                                resume_entry = (uintptr_t)ios_jit_translate_addr_for_owner(
+                                    (void *)native_entry,
+                                    thread_teb ? ((TEB *)thread_teb)->Peb : NULL);
+                                if (resume_entry && resume_entry != fault_addr &&
+                                    ios_jit_addr_is_text(resume_entry))
+                                {
+                                    static volatile int vtable_recoveries;
+                                    int n = __sync_add_and_fetch(&vtable_recoveries, 1);
+                                    __darwin_arm_thread_state64_set_pc_fptr(
+                                        state, (void *)resume_entry);
+                                    handled = 1;
+                                    if (n <= 16 || !(n & 255))
+                                        dprintf(STDERR_FILENO,
+                                            "[ec-check-vtable] #%d bad=%p vtable=%p pe=%p "
+                                            "slot=%#lx native=%p resume=%p lr=%p\n",
+                                            n, (void *)fault_addr, (void *)object_vtable,
+                                            (void *)pe_vtable, (unsigned long)slot_offset,
+                                            (void *)native_entry, (void *)resume_entry,
+                                            (void *)lr);
+                                }
+                            }
+                        }
+
+                        /* The clone ledger does not cover the bundled ContextImpl vtable,
+                         * but its three initialization-time slots are fixed by the pinned
+                         * runtime.  The failed cell also sits at object+slot+0x20 and has
+                         * a distinctive two-qword layout.  Resolve all three together so
+                         * process initialization does not require one build per call. */
+                        caller_pe = ios_jit_reverse_translate(lr, &caller_module);
+                        mach_vm_read_overwrite(mach_task_self(),
+                            (mach_vm_address_t)fault_addr, sizeof(cell_words),
+                            (mach_vm_address_t)cell_words, &cell_read);
+                        if (!handled && caller_pe && caller_module && slot_offset &&
+                            cell_read == sizeof(cell_words) &&
+                            cell_words[0] == fault_addr + 0x10 && !cell_words[1])
+                        {
+                            uintptr_t context_target_rva = 0;
+
+                            if (slot_offset == 0xe0 &&
+                                state.__x[0] + 0x100 == fault_addr)
+                                context_target_rva = 0x1d080;
+                            else if (slot_offset == 0xe8 &&
+                                     state.__x[0] + 0x108 == fault_addr)
+                                context_target_rva = 0x1d410;
+                            else if (slot_offset == 0xf0 &&
+                                     state.__x[0] + 0x110 == fault_addr)
+                                context_target_rva = 0x1deb0;
+
+                            if (context_target_rva)
+                            {
+                                native_entry = caller_module + context_target_rva;
+                                resume_entry = (uintptr_t)ios_jit_translate_addr_for_owner(
+                                    (void *)native_entry,
+                                    thread_teb ? ((TEB *)thread_teb)->Peb : NULL);
+                                if (resume_entry && resume_entry != fault_addr &&
+                                    ios_jit_addr_is_text(resume_entry))
+                                {
+                                    static volatile int context_recoveries;
+                                    int n = __sync_add_and_fetch(&context_recoveries, 1);
+                                    __darwin_arm_thread_state64_set_pc_fptr(
+                                        state, (void *)resume_entry);
+                                    handled = 1;
+                                    if (n <= 16 || !(n & 255))
+                                        dprintf(STDERR_FILENO,
+                                            "[ec-check-context] #%d bad=%p object=%p "
+                                            "slot=%#lx native=%p resume=%p lr=%p\n",
+                                            n, (void *)fault_addr, (void *)state.__x[0],
+                                            (unsigned long)slot_offset, (void *)native_entry,
+                                            (void *)resume_entry, (void *)lr);
+                                }
+                            }
+                        }
+
+                        /* Keep the already-proven getter emulation as a final fallback
+                         * if PE-to-pool translation is unexpectedly unavailable. */
+                        if (!handled && caller_pe && caller_module &&
+                            caller_pe - caller_module == 0x128e84 &&
+                            vtable_load == 0xf940790bu && check_load == 0xf9400348u &&
+                            check_call == 0xd63f0100u &&
+                            state.__x[0] + 0x110 == fault_addr &&
+                            cell_read == sizeof(cell_words) &&
+                            cell_words[0] == fault_addr + 0x10 && !cell_words[1])
+                        {
+                            static volatile int getter_recoveries;
+                            int n = __sync_add_and_fetch(&getter_recoveries, 1);
+                            state.__x[0] += 0x88;
+                            __darwin_arm_thread_state64_set_pc_fptr(state, (void *)lr);
+                            handled = 1;
+                            if (n <= 4)
+                                dprintf(STDERR_FILENO,
+                                    "[ec-check-getter] #%d object=%p result=%p lr=%p\n",
+                                    n, (void *)(state.__x[0] - 0x88),
+                                    (void *)state.__x[0], (void *)lr);
+                        }
+
+                        if (!handled)
+                        {
+                        uintptr_t cpu_area = 0;
+                        uintptr_t emulator_data[3] = {0};
+                        mach_vm_size_t area_read = 0, data_read = 0;
+
+                        if (thread_teb)
+                            mach_vm_read_overwrite(mach_task_self(),
+                                (mach_vm_address_t)(thread_teb + 0x1788), sizeof(cpu_area),
+                                (mach_vm_address_t)&cpu_area, &area_read);
+                        if (area_read == sizeof(cpu_area) && cpu_area)
+                            mach_vm_read_overwrite(mach_task_self(),
+                                (mach_vm_address_t)(cpu_area + 0x30), sizeof(emulator_data),
+                                (mach_vm_address_t)emulator_data, &data_read);
+
+                        if (data_read == sizeof(emulator_data) && emulator_data[0] &&
+                            emulator_data[1] && emulator_data[2])
+                        {
+                            static volatile int x64_recoveries;
+                            int n = __sync_add_and_fetch(&x64_recoveries, 1);
+                            state.__x[9] = fault_addr;
+                            state.__x[11] = dispatcher;
+                            __darwin_arm_thread_state64_set_pc_fptr(state, (void *)dispatcher);
+                            handled = 1;
+                            if (n <= 16 || !(n & 255))
+                                dprintf(STDERR_FILENO,
+                                    "[ec-check-x64] #%d target=%p dispatcher=%p lr=%p "
+                                    "state=%p thread=%p enter=%p\n",
+                                    n, (void *)fault_addr, (void *)dispatcher, (void *)lr,
+                                    (void *)emulator_data[0], (void *)emulator_data[1],
+                                    (void *)emulator_data[2]);
+                        }
+                        else
+                        {
+                            static volatile int unready_calls;
+                            int n = __sync_add_and_fetch(&unready_calls, 1);
+                            if (n <= 8 || !(n & 255))
+                                dprintf(STDERR_FILENO,
+                                    "[ec-check-unready] #%d target=%p ffs-read=%llu "
+                                    "state=%p thread=%p enter=%p -- refusing x64 dispatch\n",
+                                    n, (void *)fault_addr, (unsigned long long)ffs_read,
+                                    (void *)emulator_data[0], (void *)emulator_data[1],
+                                    (void *)emulator_data[2]);
+                        }
+                        }
+                    }
+                }
+            }
