+                        uintptr_t slot = 0;
+                        mach_vm_size_t slot_read = 0;
+                        mach_vm_read_overwrite(mach_task_self(),
+                            (mach_vm_address_t)(heap + 0x3b0 + (uintptr_t)ci * 8),
+                            sizeof(slot), (mach_vm_address_t)&slot, &slot_read);
