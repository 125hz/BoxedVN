+                uint64_t fault_pc = (uint64_t)__darwin_arm_thread_state64_get_pc(state);
+                uint64_t module_base = 0;
+                uint64_t pe_pc = ios_jit_reverse_translate(fault_pc, &module_base);
+                uintptr_t page = (uintptr_t)state.__x[20];
+                uintptr_t heap = 0;
+                uint32_t current_class = 0;
+                uint32_t expected_class = 0;
+                int class_matches = 0;
+                uint64_t header[8] = {0};
+                mach_vm_size_t header_read = 0;
+                uintptr_t free_head = 0;
+                int free_ok = 0, heap_ok = 0, corrupt_detected = 0, geometry_ok = 0;
+                uint32_t page_type = 0, block_count = 0;
+                uint32_t expected_block_size = 0, expected_block_count = 0;
+                uintptr_t block_base = 0, block_end = 0, clobber = 0;
+                int clobber_index = -1;
+                uint32_t sequence[4] = {0};
+                uintptr_t cpu_area = 0;
+                uintptr_t emulator_data[3] = {0};
+                mach_vm_size_t class_read = 0, heap_read = 0, sequence_read = 0;
