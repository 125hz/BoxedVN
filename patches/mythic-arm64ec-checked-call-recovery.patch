+                            "[rpm-repair-refused] #%d page=%p heap=%p bad=%#x class=%u "
+                            "geometry-ok=%d heap-ok=%d free-ok=%d slots=%d "
+                            "bsize=%u/%u count=%u/%u blocks=%p..%p head=%p "
