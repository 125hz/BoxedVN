+                 * (65536 - 128) / (n * 16). The device shows 0x7fc = 2044, which
+                 * is exactly the class-2 value, so the page really is class 2 and
+                 * only the first 8 bytes are wrong. Those 8 bytes cover both
+                 * size_class and block_size, and the observed values reassemble
+                 * into one pointer-shaped quantity, so treat them as a single
+                 * clobbered word rather than repairing the class alone. */
+                mach_vm_read_overwrite(mach_task_self(),
+                    (mach_vm_address_t)page, sizeof(header),
+                    (mach_vm_address_t)header, &header_read);
+                if (header_read == sizeof(header) && class_matches == 1 &&
+                    expected_class && expected_class < 128)
+                {
+                    page_type = (uint32_t)(header[2] >> 32);
+                    block_count = (uint32_t)header[1];
+                    free_head = (uintptr_t)header[4];
+                    expected_block_size = expected_class * 16u;
+                    expected_block_count = (0x10000u - 128u) / expected_block_size;
+                    block_base = page + 128;
+                    block_end = block_base +
