+                                    (mach_vm_address_t)(pe_vtable + slot_offset),
+                                    sizeof(native_entry), (mach_vm_address_t)&native_entry,
+                                    &slot_read);
+                            if (slot_read == sizeof(native_entry) &&
+                                native_entry >= pe_module &&
+                                native_entry < pe_module + 0x10000000ULL)
+                            {
+                                resume_entry = (uintptr_t)ios_jit_translate_addr_for_owner(
+                                    (void *)native_entry,
+                                    thread_teb ? ((TEB *)thread_teb)->Peb : NULL);
+                                if (resume_entry && resume_entry != fault_addr &&
+                                    ios_jit_addr_is_text(resume_entry))
+                                {
+                                    static volatile int vtable_recoveries;
