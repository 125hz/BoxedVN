 static int ios_va_pressure;
 
+/* bvn1: lowest address proven unmappable, or NULL until one is.
+ *
+ * The emulator asks for its per-thread arenas with an address requirement of
+ * 0x7c00000000-0x8000000000. On this device that whole band is refused: the
+ * scan reports views=0 - Wine has placed nothing there - and every single
+ * mmap in it returns ENOMEM, so it is the kernel declining the addresses
+ * themselves, not fragmentation. map_free_area still walks the band at the
+ * alignment granule before giving up, which is 262,144 failing mmap calls for
+ * one allocation. A device log measured 1.31 MILLION of them across five
+ * allocations on one thread, every one of which then succeeded immediately on
+ * the caller's unconstrained retry.
+ *
+ * That is pure latency, and it is paid again per thread: the graphics stack
+ * brings up a render thread whose ThreadInit needs the same set of arenas,
+ * while the emulator's global lock is held. Remember the floor the first time
+ * a band is exhaustively disproven and refuse later requests that sit wholly
+ * above it without walking anything.
+ *
+ * Deliberately one-way and never lowered. VA does not become mappable above a
+ * hard kernel bound, and the caller-supplied window is honoured either way -
+ * this only changes how long it takes to say no. */
+static void *ios_va_dead_floor;
+
+/* bvn2: smallest request size the floor above has actually been proven at.
+ *
+ * A band that cannot satisfy a 512MB reservation may still have room for 4KB,
+ * so a failure at one size does not license refusing every smaller one. The
+ * first cut of this got that backwards: both learning scans were 512MB
+ * requests and it then refused 4KB ones on that evidence. It caused no harm on
+ * the device that produced it, where the small requests were failing anyway,
+ * but the reasoning does not hold on a merely fragmented band.
+ *
+ * The implication runs the other way. If a request for N bytes fails at every
+ * address in a band, any request LARGER than N fails too, because it needs
+ * strictly more contiguous space. So remember the smallest size ever disproven
+ * and refuse only requests at least that large; anything smaller is still
+ * walked, and may lower this in turn. */
+static size_t ios_va_dead_min_size;
+
 /* ml116 ROOT CAUSE of the ceiling regressions (disassembly + code-path proof,
  * no device run needed):
  *
@@ -9738,15 +9777,39 @@
