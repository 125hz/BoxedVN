diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index 12ca1e8..2aa96d7 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -8201,0 +8202,17 @@ static inline int mprotect_exec( void *base, size_t size, int unix_prot )
+            /* ml702: prove which emulator DLL actually loaded. The prebuilt is
+             * patched in place at build time to refuse block_deallocate() of a
+             * page base; report whether the branch is physically present so a
+             * device log can never be read against the wrong binary. */
+            {
+                const char *bn = ios_pe_module_name( image_base, image_size );
+                if (bn && strstr(bn, "arm64ecfex") && image_size > 0x14b1f8)
+                {
+                    unsigned w1 = *(volatile unsigned *)((char *)image_base + 0x149b28);
+                    unsigned w2 = *(volatile unsigned *)((char *)image_base + 0x14a7fc);
+                    unsigned w3 = *(volatile unsigned *)((char *)image_base + 0x14b1f4);
+                    dprintf(2, "[xtajit-binpatch] badfree-v2 free=%08x span=%08x thread=%08x present=%d rev=ml703\n",
+                            w1, w2, w3,
+                            w1 == 0x1402e99fu && w2 == 0x1402e671u &&
+                            w3 == 0x1402e3fbu);
+                }
+            }
@@ -15479,0 +15497,21 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
+        if (ios_jit_orig_addr)
+        {
+            /* The caller is executing from the pool copy, so its mutable data
+             * is authoritative for this protect/write/restore cycle. Returning
+             * the parent address loses that provenance: the restore call then
+             * takes the parent-to-pool sync path and overwrites stores that ran
+             * through the RX/RW aliases. Keep the rounded address in the pool
+             * and skip the parent-to-pool copy below. */
+            uintptr_t page_delta = (uintptr_t)addr - (uintptr_t)base;
+            void *jit_base = (char *)ios_jit_orig_addr - page_delta;
+            static unsigned long jit_owned_protect_count;
+
+            *addr_ptr = jit_base;
+            if (++jit_owned_protect_count <= 32 || !(jit_owned_protect_count % 256))
+                dprintf(2, "[jit-authority] protect #%lu parent=%p pool=%p size=0x%lx "
+                           "old=0x%x new=0x%x; keeping pool ownership\n",
+                        jit_owned_protect_count, base, jit_base, (unsigned long)size,
+                        old, new_prot);
+            return status;
+        }
+
